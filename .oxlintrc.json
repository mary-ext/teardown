{
	"$schema": "https://unpkg.com/oxlint/configuration_schema.json",
	"categories": {
		"correctness": "warn",
		"suspicious": "warn",
		"perf": "warn"
	},
	"rules": {
		"no-shadow": "off",
		"unicorn/no-array-sort": "off",
		"unicorn/prefer-add-event-listener": "off",
		"unicorn/require-post-message-target-origin": "off"
	}
}
