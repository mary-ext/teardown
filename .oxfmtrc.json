{
	"$schema": "https://unpkg.com/oxfmt/configuration_schema.json",

	"trailingComma": "all",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 110,
	"semi": true,
	"singleQuote": true,
	"bracketSpacing": true,

	"experimentalSortImports": {
		"groups": [["builtin"], ["external"], ["parent"], ["sibling", "index"]]
	},
	"experimentalTailwindcss": {
		"stylesheet": "src/index.css",
		"functions": ["tw"],
		"attributes": ["class", "className", "classList"]
	},

	"overrides": [
		{
			"files": ["tsconfig.json", "tsconfig.*.json"],
			"options": {
				"parser": "jsonc"
			}
		},
		{
			"files": ["*.md"],
			"options": {
				"printWidth": 100,
				"proseWrap": "always"
			}
		}
	]
}
